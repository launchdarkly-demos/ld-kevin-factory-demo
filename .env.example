# Copy to .env. The real .env is git-ignored.

# Server-side SDK key for the Production environment of the LaunchDarkly project.
# Leave unset (or set FLIGHT_DECK_OFFLINE=1) to run with no LaunchDarkly connection.
LD_SDK_KEY=

# Used only to build deep links in the flight log.
LD_PROJECT_KEY=kevinc-release-autopilot-demo

# Port the deck listens on.
PORT=7777

# Simulated passengers per real second. 8 gives a guarded release enough
# samples to decide within one-minute steps.
SIM_RATE=8

# Seed for the simulation's random number generator. Any integer.
SIM_SEED=7

# Set to 1 to force offline mode even when LD_SDK_KEY is present.
FLIGHT_DECK_OFFLINE=

# The deck checks origin/main every 30 seconds and, when it is behind and
# running from a clean main checkout, pulls and restarts itself. Set to 0 to
# only show a warning and leave deploys to scripts/deploy.sh.
FLIGHT_DECK_AUTO_DEPLOY=

# LaunchDarkly API access token, used only by scripts/reset-demo.sh to delete
# the demo's flags. Not read by the deck.
LD_API_KEY=
