# Copy to .env. The real .env is git-ignored.

# Server-side SDK key for the Production environment of the LaunchDarkly project.
# Leave unset (or set FLIGHT_DECK_OFFLINE=1) to run with no LaunchDarkly connection.
LD_SDK_KEY=

# Used only to build deep links in the flight log.
LD_PROJECT_KEY=kevinc-release-autopilot-demo

# Port the deck listens on.
PORT=7777

# Simulated passengers per real second. 8 gives a guarded release enough
# samples to decide within one-minute steps.
SIM_RATE=8

# Seed for the simulation's random number generator. Any integer.
SIM_SEED=7

# Set to 1 to force offline mode even when LD_SDK_KEY is present.
FLIGHT_DECK_OFFLINE=

# The deck checks origin/main every 30 seconds and, when it is behind and
# running from a clean main checkout, pulls and restarts itself. Set to 0 to
# only show a warning and leave deploys to scripts/deploy.sh.
FLIGHT_DECK_AUTO_DEPLOY=

# Operate menu (the demo's helper scripts as buttons in the page header).
# The menu appears only when all four of GITHUB_TOKEN, GITHUB_REPO, LD_API_KEY
# and LD_PROJECT_KEY are set. scripts/reset-demo.sh also reads LD_API_KEY.
#
# GitHub token with repo scope on GITHUB_REPO: opens the demo PRs, posts the
# @launchdarkly commands, merges, force-pushes main back to the baseline.
# Commands posted with this token come from its owner, who must be a GitHub
# user connected to LaunchDarkly (the App ignores strangers).
GITHUB_TOKEN=
GITHUB_REPO=launchdarkly-demos/ld-kevin-factory-demo

# LaunchDarkly API access token with writer rights on LD_PROJECT_KEY: turns the
# App's flag on serving the baseline, deletes flags on reset.
LD_API_KEY=

# Environment the release runs in. Default production.
LD_ENV_KEY=production

# Shared secret the page must send to fire Operate actions. Leave blank to let
# anyone who can reach the deck use the menu (fine on a laptop, not on a
# public URL).
FLIGHT_DECK_OPS_TOKEN=

# Commit main returns to on reset. Default: tag demo-baseline, else main's
# first commit (a repo created from a template has exactly one).
FLIGHT_DECK_BASELINE_REF=

# Demo Depot per-launch provisioning (docker-entrypoint.sh, scripts/launch.mjs).
# When DD_INSTANCE_ID (set by the depot), GITHUB_TOKEN and LD_API_KEY are all
# present and GITHUB_REPO is not, the container creates ld-flight-deck-<id>
# from this template in the same org, adds the metrics and release policy to
# LD_PROJECT_KEY, maps the repo, runs from a clone of it, and deletes the repo
# on stop. Set FLIGHT_DECK_LAUNCH_ID to try it from a laptop.
FLIGHT_DECK_TEMPLATE_REPO=launchdarkly-demos/ld-kevin-factory-demo
FLIGHT_DECK_LAUNCH_ID=
