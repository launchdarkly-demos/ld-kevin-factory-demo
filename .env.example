# Copy to .env. The real .env is git-ignored.

# Server-side SDK key for the Production environment of the LaunchDarkly project.
# Leave unset (or set FLIGHT_DECK_OFFLINE=1) to run with no LaunchDarkly connection.
LD_SDK_KEY=

# Used only to build deep links in the flight log.
LD_PROJECT_KEY=kevinc-release-autopilot-demo

# Port the deck listens on.
PORT=7777

# Simulated passengers per real second.
SIM_RATE=4

# Seed for the simulation's random number generator. Any integer.
SIM_SEED=7

# Set to 1 to force offline mode even when LD_SDK_KEY is present.
FLIGHT_DECK_OFFLINE=
